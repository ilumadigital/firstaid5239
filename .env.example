# EXAMPLE ONLY — never commit real SMTP passwords or Turnstile secrets.
# Copy to the parent of public_html, e.g. /home/USER/domains/firstaid5239.gr/.env
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@enak.gr
SMTP_PASSWORD="REPLACE_WITH_NEW_MAILBOX_PASSWORD"
MAIL_FROM=info@enak.gr
MAIL_TO=info@enak.gr

# Public site key and private server-side secret, created in Cloudflare Turnstile.
TURNSTILE_SITE_KEY=REPLACE_WITH_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_SECRET_KEY
TURNSTILE_ALLOWED_HOSTNAMES=firstaid5239.gr,www.firstaid5239.gr
